{
  "manifest_version": 3,
  "name": "HealthcareGuard — AI Prompt Safety",
  "version": "1.0.0",
  "description": "Warns when healthcare-related prompts in supported AI chat websites match HealthcareGuard safety patterns.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://*.onrender.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "HealthcareGuard",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
